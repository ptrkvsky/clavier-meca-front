---
interface Props { posts?: import('../lib/types').SanityDocument[]; }
import SanityImage from './SanityImage.astro';
const { posts = [] } = Astro.props;
---
<div class="grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
  {posts.map(post => <article class="group min-w-0">
    <a href={`/${post.slug.current}`} class="block">
      <SanityImage image={post.mainImage} width={760} height={760} sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 380px" class="mb-5 aspect-square w-full object-cover" />
      <h3 class="text-2xl leading-tight font-bold tracking-tight transition-colors group-hover:text-brand">{post.title}</h3>
    </a>
  </article>)}
</div>
