{
  "name": "clavier-meca-front-end",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Clavier Meca — Astro et Tailwind CSS 4",
  "license": "MIT",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0 --port 8000",
    "develop": "npm run dev",
    "start": "npm run dev",
    "build": "astro check && astro build",
    "preview": "astro preview --host 0.0.0.0 --port 8000",
    "check": "astro check",
    "test": "node --test tests/*.test.mjs",
    "validate:build": "node scripts/validate-build.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ptrkvsky/clavier-meca-front"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@portabletext/to-html": "6.0.0",
    "@sanity/image-url": "2.1.1",
    "@tailwindcss/vite": "4.3.5",
    "astro": "7.4.7",
    "tailwindcss": "4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "linkedom": "0.18.15",
    "typescript": "6.0.3"
  }
}
